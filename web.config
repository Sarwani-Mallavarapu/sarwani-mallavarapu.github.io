<?xml version="1.0" encoding="UTF-8"?>
<!-- GECE website - IIS configuration.
     Requires the IIS "URL Rewrite" module (free download from Microsoft). Without it IIS shows error 500.19.
     Assumes the site is deployed at the root of the domain (https://www.geceindia.com/).
     To add a redirect: add one <add key="old-page.html" value="/new-page.html" /> line to the rewriteMap below.
     Keys must be in lower case. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
    <rewrite>
      <rewriteMaps>
        <rewriteMap name="LegacyRedirects" defaultValue="">
          <add key="aboutus.html" value="/about.html" />
          <add key="contactus.html" value="/contact.html" />
          <add key="achievements.html" value="/certifications.html" />
          <add key="partners.html" value="/certifications.html" />
          <add key="feedback.html" value="/contact.html" />
          <add key="news.html" value="/insights.html" />
          <add key="gallery.html" value="/about.html" />
          <add key="downloads.html" value="/products.html" />
          <add key="construction.html" value="/index.html" />
          <add key="test.html" value="/index.html" />
          <add key="header.html" value="/index.html" />
          <add key="footer.html" value="/index.html" />
          <add key="powercrm.html" value="/crm.html" />
          <add key="powerda.html" value="/powerdas.html" />
          <add key="poweroutage.html" value="/powerdas.html" />
          <add key="powerems-backup.html" value="/powerems.html" />
          <add key="powerrda-backup.html" value="/products.html" />
          <add key="powerrda.html" value="/products.html" />
          <add key="powerassetmanagement.html" value="/powerasset.html" />
          <add key="long-term-planning.html" value="/long-term-load-forecast.html" />
          <add key="microgrid.html" value="/smart-grids.html" />
          <add key="commercial-loss-management.html" value="/enterprise-asset-management.html" />
          <add key="date-center.html" value="/data-center.html" />
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <rule name="Legacy 301 redirects" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions>
            <add input="{LegacyRedirects:{ToLower:{R:1}}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
